[Unit]
Description=gobill billing server
Documentation=https://github.com/frand-kod/gobill
# STB tidak punya RTC: tunggu NTP sinkron sebelum start.
After=time-sync.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gobill
Group=gobill
EnvironmentFile=/etc/gobill/config.env
ExecStart=/usr/local/bin/gobill
StateDirectory=gobill
# Folder backup di USB/NAS: tambahkan lewat drop-in, mis. ReadWritePaths=/mnt/usb/gobill-backup
# Folder mirror backup (GOBILL_BACKUP_MIRROR) juga perlu drop-in ReadWritePaths sendiri, mis. ReadWritePaths=/mnt/nas/gobill-backup
Restart=on-failure
RestartSec=5

# Hardening. Port 8080 dan 1812/1813 di atas 1024, jadi tidak perlu CAP_NET_BIND_SERVICE.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gobill
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
