[Unit]
Description=NuxBill billing server
Documentation=https://github.com/frand-kod/gobill
# STB tidak punya RTC: tunggu NTP sinkron sebelum start.
After=time-sync.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nuxbill
Group=nuxbill
EnvironmentFile=/etc/nuxbill/config.env
ExecStart=/usr/local/bin/nuxbill
StateDirectory=nuxbill
# Folder backup di USB/NAS: tambahkan lewat drop-in, mis. ReadWritePaths=/mnt/usb/nuxbill-backup
# Folder mirror backup (NUXBILL_BACKUP_MIRROR) juga perlu drop-in ReadWritePaths sendiri, mis. ReadWritePaths=/mnt/nas/nuxbill-backup
Restart=on-failure
RestartSec=5

# Hardening. Port 8080 dan 1812/1813 di atas 1024, jadi tidak perlu CAP_NET_BIND_SERVICE.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/nuxbill
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
