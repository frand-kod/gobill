# =============================================================================
#  gobill environment configuration
# =============================================================================
#
#  With systemd this file lives at /etc/gobill/config.env and is loaded by the
#  unit's EnvironmentFile= line. With Docker, pass it with --env-file or
#  env_file: in compose. gobill itself does not read any .env file: the
#  service manager turns these lines into environment variables.
#
#  Format: KEY=value, one per line. No spaces around "=". Lines starting with
#  "#" are comments. A commented-out key uses its built-in default.
#
#  These are per-server settings, read once at startup. Business settings
#  (plans, payment gateway, notifications, trust_proxy, ...) live in the
#  database and are changed in the admin UI under Settings, without a restart.
#
#  After editing:  sudo systemctl restart gobill
#  Print this template from the binary:  gobill config-example
#
#  This file holds GOBILL_SECRET_KEY: keep it mode 0600, owned by root.


# -----------------------------------------------------------------------------
#  Core
# -----------------------------------------------------------------------------

# Path of the SQLite database. The folder must be writable by the gobill user.
# `gobill import`, `gobill update` and `gobill rollback` read it from here too.
# Default: ./gobill.db (Docker image: /data/gobill.db)
GOBILL_DB=/var/lib/gobill/gobill.db

# HTTP listen address for the admin UI, customer portal and /radius.php.
# Use host:port. For isolir (captive redirect of expired customers), set the
# LAN IP the routers can reach, e.g. 192.168.99.2:8090, so the generated
# MikroTik commands point at the right address. Empty host or 0.0.0.0 makes
# gobill pick the first LAN IPv4 of the host for those commands.
# Default: :8080
GOBILL_HTTP=:8080

# Secure flag on session cookies. Leave unset (enabled) when the UI is served
# over HTTPS, including behind cloudflared or a reverse proxy.
# Set to 0 ONLY when you open the UI over plain http:// by IP on a LAN;
# browsers drop Secure cookies on http:// (except localhost) and login would
# loop. Startup logs a warning while it is 0.
# Default: enabled
# GOBILL_HTTPS=0

# AES-GCM key (64 hex chars) that encrypts router, NAS and customer secrets
# stored in the database. install.sh generates one.
# If unset, gobill creates <GOBILL_DB>.key on first start and uses that file.
# Losing this key means the stored secrets cannot be decrypted: back it up
# together with the database. Never change it on a running install.
GOBILL_SECRET_KEY=


# -----------------------------------------------------------------------------
#  RADIUS
# -----------------------------------------------------------------------------

# UDP listen address of the built-in RADIUS server. Authentication uses this
# port, accounting uses the next one (1812 -> 1813).
# Set to "off" (or empty) when FreeRADIUS already owns 1812/1813 and talks to
# gobill through /radius.php instead.
# Default: :1812
GOBILL_RADIUS=:1812

# [Advanced] How long an open RADIUS session may go without an
# Interim-Update before gobill treats it as stale. A stale session no longer
# counts toward a plan's shared_users limit and shows as stale in the admin
# and portal pages.
#
# Rule of thumb: about 2x the NAS interim interval. The default assumes a
# 5-minute interim (MikroTik: /radius incoming / PPP AAA "Interim Update").
#   - interim 10m on the NAS  -> set 20m, or customers who are online look
#     offline and can log in on more devices than shared_users allows;
#   - interim 1m on the NAS   -> 3m frees a slot faster after a router
#     reboot that never sent Accounting-Stop.
# Accepted: Go duration between 1m and 1h, e.g. 90s, 10m, 20m.
# Default: 10m
# GOBILL_STALE_AFTER=10m

# [Advanced] A NAS shows as "online" on the dashboard Network card while its
# newest RADIUS packet is at most this old. gobill stores no heartbeat, so a
# quiet NAS with no logins and a long interim can look offline. Raise it if
# you see false "offline" on small sites at night.
# Accepted: Go duration between 1m and 24h.
# Default: 15m
# GOBILL_NAS_ONLINE_WINDOW=15m


# -----------------------------------------------------------------------------
#  Backups
# -----------------------------------------------------------------------------

# Folder for the daily backup and the automatic backups taken before an
# import, restore, recovery or `gobill update`.
# Default: a "backup" folder next to GOBILL_DB
# GOBILL_BACKUP_DIR=/var/lib/gobill/backup

# A second copy of the daily backups, e.g. a USB disk, NAS mount or rclone
# folder. The folder must already exist and be writable by the gobill user;
# with systemd also add it to ReadWritePaths= in the unit.
# Default: off
# GOBILL_BACKUP_MIRROR=/mnt/usb/gobill-backup


# -----------------------------------------------------------------------------
#  Runtime tuning (Go)
# -----------------------------------------------------------------------------

# [Advanced] Soft memory limit for the Go heap, e.g. 120MiB.
# When unset gobill picks one itself: 70% of the cgroup/container limit, or
# half the system RAM. At 256 MiB or less the SQLite page cache shrinks too.
# Set it only when other heavy services share a small board (STB, Pi).
# Default: automatic
# GOMEMLIMIT=120MiB

# [Advanced] Number of OS threads running Go code at once.
# gobill raises it to at least 2 on single-core boards so a slow SD/eMMC
# fsync does not freeze RADIUS handling. Leave unset unless benchmarking.
# Default: number of CPUs, minimum 2
# GOMAXPROCS=2


# -----------------------------------------------------------------------------
#  Debugging [Experimental]
# -----------------------------------------------------------------------------

# Go profiler (net/http/pprof) listen address, for bench/ and performance
# work. It has NO login: bind it to loopback only, never 0.0.0.0.
# Default: off
# GOBILL_PPROF=127.0.0.1:6060
